---
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us - Ampick',
  description: 'Learn more about Ampick, your trusted platform for latest scholarships, sarkari yojana, and educational updates.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Ampick Team',
    }}
  >
    <Fragment slot="title">
      विद्यार्थियों और युवाओं के लिए <br />
      <span class="text-accent dark:text-white">भरोसेमंद सूचना मंच</span>
    </Fragment>

    <Fragment slot="subtitle">
      <strong>Ampick</strong> पर आपका स्वागत है! यह वेबसाइट विशेष रूप से भारत के विद्यार्थियों और युवाओं के लिए बनाई गई है। 
      यहाँ आपको कक्षा 9वीं से लेकर ग्रेजुएशन और उच्च शिक्षा तक मिलने वाली सभी प्रकार की लेटेस्ट स्कॉलरशिप, केंद्र और राज्य सरकार की 
      सरकारी योजनाओं, और शैक्षणिक अपडेट्स की सटीक जानकारी सबसे पहले मिलती है।
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->
  <Stats
    title="हमारी विशेषताएं (Our Reach)"
    stats={[
      { title: 'Daily Readers', amount: '10K+' },
      { title: 'Scholarships', amount: '50+' },
      { title: 'Sarkari Yojanas', amount: '100+' },
      { title: 'Updates', amount: '100%' },
    ]}
  />

  <!-- Features3 Widget ************** -->
  <Features3
    title="हम क्या प्रदान करते हैं?"
    subtitle="छात्रों के उज्ज्वल भविष्य के लिए हम निम्नलिखित श्रेणियों में सटीक और समय पर जानकारी उपलब्ध कराते हैं।"
    columns={3}
    items={[
      {
        title: 'स्कॉलरशिप (Scholarships)',
        description: 'मेधावी और जरूरतमंद छात्रों के लिए प्राइवेट और सरकारी छात्रवृत्तियों की पूरी जानकारी और आवेदन प्रक्रिया।',
        icon: 'tabler:school',
      },
      {
        title: 'सरकारी योजनाएं (Sarkari Yojana)',
        description: 'केंद्र और राज्य सरकार की सभी कल्याणकारी योजनाओं, छात्र लाभ और आवेदन के तरीकों की सरल भाषा में जानकारी।',
        icon: 'tabler:file-description',
      },
      {
        title: 'एजुकेशन व जॉब्स (Jobs & Result)',
        description: 'नई सरकारी भर्तियां, बोर्ड रिजल्ट, एडमिट कार्ड और शैक्षणिक जगत की हर बड़ी खबर।',
        icon: 'tabler:briefcase',
      },
    ]}
  />
</Layout>
