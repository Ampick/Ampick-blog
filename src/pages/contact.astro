---
import ContactUs from '~/components/widgets/Contact.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Us - Ampick',
  description: 'Get in touch with Ampick for any queries, scholarship updates, or feedback.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="Contact us"
    title="Get in Touch with Us"
    subtitle="यदि आपके पास कोई सवाल, सुझाव या स्कॉलरशिप/योजना से संबंधित कोई जानकारी है, तो आप नीचे दिए गए माध्यमों से हमसे संपर्क कर सकते हैं।"
  />

  <!-- Contact Us Widget ****************** -->
  <ContactUs
    id="form"
    title="हमें संदेश भेजें (Send us a message)"
    subtitle="हम आमतौर पर 24 घंटे के भीतर आपके संदेश का जवाब देते हैं।"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'आपका नाम (Your Name)',
      },
      {
        type: 'email',
        name: 'email',
        label: 'ईमेल आईडी (Email Address)',
      },
    ]}
    textarea={{
      label: 'आपका संदेश (Your Message)',
    }}
    disclaimer={{
      label: 'फॉर्म जमा करके आप हमारी गोपनीयता नीति (Privacy Policy) से सहमत होते हैं।',
    }}
    button="संदेश भेजें (Send Message)"
  />
</Layout>
