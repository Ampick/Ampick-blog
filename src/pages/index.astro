---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Ampick – Latest Scholarships, Sarkari Yojana & Education Updates',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'लेटेस्ट स्कॉलरशिप देखें',
        href: '#posts',
        icon: 'tabler:arrow-down',
      },
      { text: 'सरकारी योजनाएं', href: '/category/sarkari-yojana' },
    ]}
  >
    <Fragment slot="title">
      विद्यार्थियों के लिए <span class="text-accent dark:text-white highlight">लेटेस्ट स्कॉलरशिप</span> और सरकारी योजनाएं
    </Fragment>

    <Fragment slot="subtitle">
      कक्षा 9वीं से लेकर ग्रेजुएशन और उच्च शिक्षा तक के छात्रों के लिए सभी नई छात्रवृत्तियां, आवेदन प्रक्रिया और योग्यता की पूरी जानकारी सबसे पहले यहाँ प्राप्त करें।
    </Fragment>
  </Hero>

  <Features2
    title="प्रमुख श्रेणियां (Top Categories)"
    subtitle="अपनी जरूरत के अनुसार सही योजना या छात्रवृत्ति की जानकारी तुरंत खोजें।"
    tagline="Categories"
    items={[
      {
        title: 'स्कॉलरशिप (Scholarships)',
        description: 'प्राइवेट और सरकारी छात्रवृत्तियां जो मेधावी और जरूरतमंद छात्रों को आर्थिक मदद देती हैं।',
        icon: 'tabler:school',
      },
      {
        title: 'सरकारी योजनाएं (Sarkari Yojana)',
        description: 'केंद्र और राज्य सरकार की सभी कल्याणकारी योजनाएं और उनके लाभ लेने का तरीका।',
        icon: 'tabler:file-Check',
      },
      {
        title: 'एजुकेशन व जॉब्स (Jobs & Result)',
        description: 'नई सरकारी भर्तियां, बोर्ड रिजल्ट, एडमिट कार्ड और शैक्षणिक जगत की हर बड़ी खबर।',
        icon: 'tabler:briefcase',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    id="posts"
    title="ताज़ा आर्टिकल्स (Latest Posts)"
    information="यहाँ हमारे द्वारा पब्लिश किए गए सभी नए और अपडेटेड आर्टिकल्स की सूची दी गई है।"
  />
</Layout>
